## type_text

{
  "name": "type_text",
  "title": "Type text",
  "description": "Type text into the currently focused widget.\nOptionally focus a widget first (by `id`, `role`, or a text match — `content_contains`/`label_contains`/`value_contains`) — this uses an `AccessKit` focus request, not a click, so it won't move the cursor or clear an existing text selection.",
  "inputSchema": {
    "$defs": {
      "Id": {
        "description": "Widget id as `widget_tree` reports it: lower-case hex, no prefix.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "content_contains": {
        "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional focus target: widget id from `widget_tree` to focus before typing.\nOmit all locator fields to type into whatever is currently focused."
      },
      "label_contains": {
        "description": "Case-insensitive substring match against the widget's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
        "type": [
          "string",
          "null"
        ]
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
        "type": [
          "string",
          "null"
        ]
      },
      "text": {
        "type": "string"
      },
      "value_contains": {
        "description": "Case-insensitive substring match against the widget's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "text"
    ],
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}

## wait_for

{
  "name": "wait_for",
  "title": "Wait for widgets",
  "description": "Poll the widget tree until its conditions hold, or until `timeout_secs` elapses.\nWaits until at least `min_matches` visible widgets match the filter (when one is given) *and* at least `min_steps` frames have rendered since the call began.\nThe text filter is `role` and/or one of `content_contains` (matches `label` or `value` — prefer this; e.g. monospace/`Label` text lives in `value`), `label_contains`, `value_contains`.\nRequires a filter (`content_contains`/`role`/`label_contains`/`value_contains`) or a non-zero `min_steps`.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "content_contains": {
        "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
        "type": [
          "string",
          "null"
        ]
      },
      "label_contains": {
        "description": "Case-insensitive substring match against the widget's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
        "type": [
          "string",
          "null"
        ]
      },
      "min_matches": {
        "default": 1,
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "min_steps": {
        "default": 0,
        "description": "Also wait until at least this many frames have rendered since the call began.\nUse it to let animations, tooltips, or other time/frame-driven UI settle (e.g. after a `hover`); `0` means don't wait for frames.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
        "type": [
          "string",
          "null"
        ]
      },
      "timeout_secs": {
        "default": 5,
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "value_contains": {
        "description": "Case-insensitive substring match against the widget's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}

## widget_tree

{
  "name": "widget_tree",
  "title": "Widget tree",
  "description": "Walk the app's widget tree and return the widgets matching the filter, nested by ancestry: each one carries the matches from its own subtree in `children`.\nWidgets in between that don't match are skipped, so a `children` entry is a descendant, not necessarily a direct child.\n`role`, if given, is a role name (e.g. `Button`, `Label`), matched case-insensitively; an unknown role errors with the roles present in the tree.\n`limit` (200 by default) caps how many widgets come back: whole levels are kept from the top down, so the app's structure survives and the leaves go first, and any widget whose children were cut reports how many in `omitted_children`.\n`root` starts the walk at one widget instead of the app's root — pass the `id` of a widget that reported `omitted_children` to see that part of the tree in full.\n`exclude` leaves a subtree out — pass a widget `id`, or the same constraints the filter takes — and takes everything below it with it; use it to skip a panel whose text would otherwise answer every query.\nUse the returned `id` with `click`, `type_text`, or `get_widget`.\nThe widgets are abridged — call `get_widget` with an `id` for one widget's full detail, including its `bounds` (logical points, its center is where `click` lands), its parent, and its text in full.\n`label` and `value` are cut short at 100 characters, marked with a trailing ` […]`; the filters still match against the whole text, so a phrase past the cut still finds its widget.\nEmpty scaffolding is dropped: a widget with no children, no `label`, no `value`, and no `role` (a `role` of `Unknown` is reported as none) never appears.",
  "inputSchema": {
    "$defs": {
      "Exclusion": {
        "description": "A subtree to leave out of a query: whatever matches, plus everything below it.\n\nEither a widget `id` or the same constraints a [`Query`] takes. An exclusion with neither set\nmatches nothing, rather than swallowing the whole tree.",
        "properties": {
          "content_contains": {
            "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "anyOf": [
              {
                "$ref": "#/$defs/Id"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Id of the widget to leave out, from a previous query."
          },
          "label_contains": {
            "description": "Case-insensitive substring match against the widget's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
            "type": [
              "string",
              "null"
            ]
          },
          "value_contains": {
            "description": "Case-insensitive substring match against the widget's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Id": {
        "description": "Widget id as `widget_tree` reports it: lower-case hex, no prefix.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "content_contains": {
        "description": "Case-insensitive substring match against *either* `label` or `value`. Prefer this when you\njust want \"the widget showing this text\" and don't care which field holds it — it's the\nmost robust choice across widget kinds.",
        "type": [
          "string",
          "null"
        ]
      },
      "exclude": {
        "anyOf": [
          {
            "$ref": "#/$defs/Exclusion"
          },
          {
            "type": "null"
          }
        ],
        "description": "A subtree to leave out — e.g. the host's own agent panel, whose text would otherwise\nanswer every text query before the app under test does."
      },
      "label_contains": {
        "description": "Case-insensitive substring match against the widget's `label` (its accessible name) only.\nNote that `Label`/monospace widgets carry their text in `value`, not `label` — for those,\nuse `content_contains` (or `value_contains`).",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "default": 200,
        "description": "Most widgets to return, counted over the whole forest and not per level. The default of\n200 keeps a whole-app query down to something an agent can read.\n\nOverflow is cut from the bottom up, so the top of the hierarchy always survives, and\neach widget that lost children reports how many in its `omitted_children`.",
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "role": {
        "description": "Role name, e.g. `Button`, `Label`, `TextInput` (case-insensitive).\nAn unrecognized role is rejected with an error that lists the roles present in the tree.",
        "type": [
          "string",
          "null"
        ]
      },
      "root": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Walk this widget's subtree instead of the whole app — the way to see the children a\n`limit` left out, by passing the id of the widget that reported `omitted_children`."
      },
      "value_contains": {
        "description": "Case-insensitive substring match against the widget's `value` only (e.g. a text field's\ncontents, or a `Label`'s text).",
        "type": [
          "string",
          "null"
        ]
      },
      "visible_only": {
        "default": true,
        "description": "Skip the widgets egui reports as hidden — scrolled out of view, or inside a collapsed\nsection. On by default: a hidden widget can't be clicked or read by a user, so it is\nrarely the one an agent is looking for. Set it to `false` to see what a `ScrollArea` or\na closed `CollapsingHeader` is holding.",
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "Id": {
        "description": "Widget id as `widget_tree` reports it: lower-case hex, no prefix.",
        "pattern": "^[0-9a-fA-F]{1,16}$",
        "type": "string"
      },
      "Widget": {
        "description": "A widget in `widget_tree`'s hierarchical result.\n\nOnly matching widgets appear; each one nests the matches found in its own subtree. A\nnon-matching widget contributes its matches to its nearest matching ancestor, so a\n`children` entry is not necessarily a direct child in the app's tree.\n\nDeliberately leaner than [`WidgetDetail`]: a whole tree of `bounds` is a lot of numbers for an\nagent to read past, and actions take an `id` anyway. `get_widget` has the full detail.\n\nA widget that says nothing — no children, no `label`, no `value` and no role — is dropped\nentirely, as is a `TextRun` that only repeats its parent's text.\n\n`label` and `value` are cut short at [`MAX_TEXT_CHARS`], marked with a trailing\n[`TRUNCATION_MARKER`].",
        "properties": {
          "children": {
            "description": "`default` keeps the derived schema honest: a leaf omits the field entirely.",
            "items": {
              "$ref": "#/$defs/Widget"
            },
            "type": "array"
          },
          "disabled": {
            "type": "boolean"
          },
          "focused": {
            "description": "Each flag is omitted when false — that is the state of nearly every widget.",
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/Id",
            "description": "Node id, used with `click`, `type_text`, and `get_widget`."
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "omitted_children": {
            "description": "How many of this widget's children `limit` left out. Query again with this widget's\n`id` as `root` to see them, or raise `limit`, or narrow the filter.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "description": "Omitted for a role of `Unknown`, which carries no information.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "nodes": {
        "items": {
          "$ref": "#/$defs/Widget"
        },
        "type": "array"
      }
    },
    "required": [
      "nodes"
    ],
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}
